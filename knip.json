{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": [
        "src/**/*.ts"
      ],
      "entry": [
        "src/cli/**/*.ts",
        "src/webui/**/*.ts",
        "src/agent/index.ts",
        "src/telegram/index.ts",
        "src/telegram/callbacks/index.ts",
        "src/sdk/hooks/index.ts",
        "src/constants/index.ts",
        "src/api/**/*.ts"
      ]
    },
    "packages/sdk": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "web": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  },
  "ignoreDependencies": [
    "@grammyjs/types"
  ],
  "ignoreExportsUsedInFile": true
}
